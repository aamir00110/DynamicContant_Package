FUNCTION CLOSE_COMPLAINT_R (   P_COMPLAINT_NO IN MS_COMPLAINT_H.COMPLAINT_NO%TYPE
    )
    RETURN VARCHAR2
    IS
        L_STATUS MS_COMPLAINT_H.STATUS_CODE%TYPE;
        L_REASON MS_COMPLAINT_H.REASON%TYPE;
        
    BEGIN

        SELECT STATUS_CODE,REASON
          INTO L_STATUS,L_REASON
          FROM MS_COMPLAINT_H
         WHERE COMPLAINT_NO = P_COMPLAINT_NO;
        IF L_STATUS = 'IN_PROGRESS' AND L_REASON IS NOT NULL THEN
            RETURN 'Y';
        ELSE
            RETURN 'N';
        END IF;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RETURN 'N';
        WHEN TOO_MANY_ROWS THEN
            RETURN 'N';
    END CLOSE_COMPLAINT_R;

