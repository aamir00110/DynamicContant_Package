    ADD_HTML('<div class="eh-kpi-grid">');

    -- Total Complaints: click => opens Page 11
    ADD_HTML(KPI('Total Complaints',L_TOTAL,'COMPLAINT','blue','ALL RECORDS',11));
    ADD_HTML(KPI('Resolved Complaints',L_RESOLVED,'CHECK','green','RESOLVED + CLOSED',14));
    ADD_HTML(KPI('Pending Complaints',L_PENDING,'CLOCK','orange','NOT CLOSED',13));
    ADD_HTML(KPI('Cancelled',L_CANCELLED,'CANCEL','red','Cancelled',13));
    ADD_HTML(KPI('PM Due This Week',L_PM_DUE,'CALENDAR','purple','NEXT 7 DAYS',11));

    ADD_HTML('</div>');

    ------------------------------------------------------------------
    -- 6. MACHINE STATUS + HALL PERFORMANCE
    ------------------------------------------------------------------

    ADD_HTML(
      '<div class="eh-section-title">Machine Status Overview</div>' ||
      '<div class="eh-layout">' ||
      '<div class="eh-panel">' ||
      '<h3><span>◉</span> Machine Status<em class="eh-ms-total">' ||
      N(L_TOTAL_MACHINES) || ' Total</em></h3>'
    );

    DECLARE
        L_RUN_PCT NUMBER := 0;
        L_DOWN_PCT NUMBER := 0;
        L_MAINT_PCT NUMBER := 0;
    BEGIN
        IF L_TOTAL_MACHINES > 0 THEN
            L_RUN_PCT := ROUND(L_RUNNING/L_TOTAL_MACHINES*100);
            L_DOWN_PCT := ROUND(L_DOWN/L_TOTAL_MACHINES*100);
            L_MAINT_PCT := ROUND(L_MAINTENANCE/L_TOTAL_MACHINES*100);
        END IF;

        ADD_HTML(
          '<div class="eh-ms-body">' ||

          -- Donut chart (cumulative conic-gradient)
          '<div class="eh-donut" style="background:conic-gradient(' ||
          '#10b981 0 ' || TO_CHAR(LEAST(L_RUN_PCT,100)) || '%,' ||
          '#f59e0b ' || TO_CHAR(LEAST(L_RUN_PCT,100)) || '% ' ||
                        TO_CHAR(LEAST(L_RUN_PCT+L_MAINT_PCT,100)) || '%,' ||
          '#ef4444 ' || TO_CHAR(LEAST(L_RUN_PCT+L_MAINT_PCT,100)) || '% ' ||
                        TO_CHAR(LEAST(L_RUN_PCT+L_MAINT_PCT+L_DOWN_PCT,100)) || '%,' ||
          '#e2e8f0 ' || TO_CHAR(LEAST(L_RUN_PCT+L_MAINT_PCT+L_DOWN_PCT,100)) || '% 100%)">' ||
          '<div class="eh-donut-hole"><strong>' || N(L_TOTAL_MACHINES) ||
          '</strong><small>MACHINES</small></div></div>' ||

          -- Legend
          '<div class="eh-ms-legend">' ||

          '<div class="eh-ms-row"><i style="background:#10b981"></i>' ||
          '<span>Running</span><b>' || N(L_RUNNING) || '</b>' ||
          '<em>' || N(L_RUN_PCT) || '%</em></div>' ||

          '<div class="eh-ms-row"><i style="background:#f59e0b"></i>' ||
          '<span>Maintenance</span><b>' || N(L_MAINTENANCE) || '</b>' ||
          '<em>' || N(L_MAINT_PCT) || '%</em></div>' ||

          '<div class="eh-ms-row"><i style="background:#ef4444"></i>' ||
          '<span>Pending</span><b>' || N(L_DOWN) || '</b>' ||
          '<em>' || N(L_DOWN_PCT) || '%</em></div>' ||

          '</div></div>'
        );
    END;

    ADD_HTML('</div>');

    ADD_HTML('<div class="eh-panel"><h3><span>▥</span> Hall Performance</h3>');

    DECLARE
        L_FOUND BOOLEAN := FALSE;
        L_MAX_COUNT NUMBER := 1;
    BEGIN
        SELECT GREATEST(NVL(MAX(MACHINE_COUNT),0),1)
          INTO L_MAX_COUNT
          FROM (
              SELECT H.HALL_ID,COUNT(M.MACHINE_ID) MACHINE_COUNT
                FROM EM_HALLS H
                LEFT JOIN EM_MACHINES M
                  ON M.HALL_ID = H.HALL_ID
                 AND M.ACTIVE_YN = 'Y'
               WHERE H.ACTIVE_YN = 'Y'
               GROUP BY H.HALL_ID
          );

        FOR H IN (
            SELECT H.HALL_NAME,COUNT(M.MACHINE_ID) MACHINE_COUNT
              FROM EM_HALLS H
              LEFT JOIN EM_MACHINES M
                ON M.HALL_ID = H.HALL_ID
               AND M.ACTIVE_YN = 'Y'
             WHERE H.ACTIVE_YN = 'Y'
             GROUP BY H.HALL_ID,H.HALL_NAME
             ORDER BY H.HALL_NAME
        )
        LOOP
            L_FOUND := TRUE;

            ADD_HTML(
              '<div class="eh-progress-row">' ||
              '<div class="eh-progress-label"><span>' ||
              E(H.HALL_NAME) || '</span><b>' ||
              N(H.MACHINE_COUNT) || ' Machines</b></div>' ||
              '<div class="eh-progress"><span style="width:' ||
              TO_CHAR(ROUND(H.MACHINE_COUNT/L_MAX_COUNT*100)) ||
              '%;background:linear-gradient(90deg,#2563eb,#8b5cf6)"></span></div>' ||
              '</div>'
            );
        END LOOP;

        IF NOT L_FOUND THEN
            ADD_HTML('<div class="eh-empty">No active halls found.</div>');
        END IF;
    END;

    ADD_HTML('</div></div>');

     ------------------------------------------------------------------
    -- 10. HALL SELECTION - ALWAYS VISIBLE
    ------------------------------------------------------------------

------------------------------------------------------------------
-- 10. MACHINE STATUS OVERVIEW + HALL SELECTION
------------------------------------------------------------------

ADD_HTML(
    '<div class="eh-section-title">Machine Status Overview</div>' ||
    '<div class="eh-hall-grid">'
);

DECLARE
    L_FOUND BOOLEAN := FALSE;
BEGIN
    FOR H IN (
        SELECT HALL_ID, HALL_CODE, HALL_NAME
          FROM EM_HALLS
         WHERE ACTIVE_YN = 'Y'
         ORDER BY HALL_NAME
    )
    LOOP
        DECLARE
            L_COUNT NUMBER;
            L_URL   VARCHAR2(4000);
        BEGIN
            L_FOUND := TRUE;

            SELECT COUNT(*)
              INTO L_COUNT
              FROM EM_MACHINES
             WHERE HALL_ID = H.HALL_ID
               AND ACTIVE_YN = 'Y';

            L_URL := APEX_PAGE.GET_URL(
                P_PAGE   => 3,
                P_ITEMS  => 'P3_DEPARTMENT_ID',
                P_VALUES => TO_CHAR(H.HALL_ID)
            );

            ADD_HTML(
                '<a class="eh-card" href="' ||
                APEX_ESCAPE.HTML_ATTRIBUTE(L_URL) || '">' ||

                '<div class="eh-card-icon">🏭</div>' ||

                '<div class="eh-card-title">' ||
                E(H.HALL_NAME) ||
                '</div>' ||

                '<div class="eh-card-meta">Hall Code: ' ||
                E(H.HALL_CODE) ||
                '</div>' ||

                '<span class="eh-card-count">' ||
                N(L_COUNT) || ' MACHINES</span>' ||

                '<span class="eh-card-arrow">→</span>' ||

                '</a>'
            );
        END;
    END LOOP;

    IF NOT L_FOUND THEN
        ADD_HTML(
            '<div class="eh-empty">No active halls found.</div>'
        );
    END IF;
END;

ADD_HTML('</div>');

    ------------------------------------------------------------------
    -- 7. UPCOMING PM WORK ORDERS
    ------------------------------------------------------------------

    ADD_HTML(
      '<div class="eh-section-title">Upcoming Preventive Maintenance</div>' ||
      '<div class="eh-panel">' ||
      '<h3><span>▦</span> Upcoming PM Schedule</h3>' ||
      '<div class="eh-table-wrap"><table class="eh-table">' ||
      '<thead><tr>' ||
      '<th>Work Order</th><th>Machine ID</th><th>Target Date</th>' ||
      '<th>Priority</th><th>Status</th>' ||
      '</tr></thead><tbody>'
    );

    DECLARE
        L_FOUND BOOLEAN := FALSE;
    BEGIN
        FOR W IN (
            SELECT WORK_ORDER_NO,MACHINE_ID,TARGET_DATE,PRIORITY,STATUS_CODE
              FROM MS_PM_WORK_ORDER
             WHERE TARGET_DATE >= TRUNC(SYSDATE)
               AND TARGET_DATE < TRUNC(SYSDATE)+8
               AND UPPER(NVL(STATUS_CODE,'PENDING'))
                   NOT IN ('COMPLETED','CLOSED','CANCELLED')
             ORDER BY TARGET_DATE
        )
        LOOP
            L_FOUND := TRUE;

            ADD_HTML(
              '<tr><td><b>' || E(W.WORK_ORDER_NO) || '</b></td>' ||
              '<td>' || N(W.MACHINE_ID) || '</td>' ||
              '<td>' || TO_CHAR(W.TARGET_DATE,'DD-MON-YYYY') || '</td>' ||
              '<td>' || E(W.PRIORITY) || '</td>' ||
              '<td>' || STATUS_BADGE(W.STATUS_CODE) || '</td></tr>'
            );
        END LOOP;

        IF NOT L_FOUND THEN
            ADD_HTML('<tr><td colspan="5">No upcoming PM work orders.</td></tr>');
        END IF;
    END;

    ADD_HTML('</tbody></table></div></div>');

    ------------------------------------------------------------------
    -- 8. RECENT COMPLAINTS + CHANGE PARTS TOTAL
    ------------------------------------------------------------------

ADD_HTML(
    '<div class="eh-section-title">Recent Complaints & Change Parts</div>' ||
    '<div class="eh-panel">' ||
    '<h3><span>▤</span> Complaint Wise Parts Summary</h3>' ||
    '<div class="eh-table-wrap"><table class="eh-table">' ||
    '<thead><tr>' ||
    '<th>Complaint No</th>' ||
    '<th>Machine Name</th>' ||
    '<th>Fault Description</th>' ||
    '<th>Status</th>' ||
    '<th>Items</th>' ||
    '<th>Total Qty</th>' ||
    '<th>Total Parts Price</th>' ||
    '</tr></thead><tbody>'
);

DECLARE
    L_FOUND BOOLEAN := FALSE;
BEGIN
    FOR C IN (
        SELECT
            H.COMPLAINT_ID,
            H.COMPLAINT_NO,
            EM.MACHINE_NAME,
            H.FAULT_DESCRIPTION,
            H.STATUS_CODE,
            H.COMPLAINT_DATE,
            NVL(P.TOTAL_ITEMS, 0) TOTAL_ITEMS,
            NVL(P.TOTAL_QTY, 0) TOTAL_QTY,
            NVL(P.TOTAL_PRICE, 0) TOTAL_PRICE
        FROM MS_COMPLAINT_H H
        LEFT JOIN EM_MACHINES EM
            ON EM.MACHINE_ID = H.MACHINE_ID
        LEFT JOIN (
            SELECT
                COMPLAINT_ID,
                COUNT(*) TOTAL_ITEMS,
                SUM(NVL(CHANGE_PARTS_QTY, 0)) TOTAL_QTY,
                SUM(
                    NVL(CHANGE_PARTS_PRICE, 0) *
                    NVL(CHANGE_PARTS_QTY, 0)
                ) TOTAL_PRICE
            FROM MS_CHANGE_PART
            GROUP BY COMPLAINT_ID
        ) P
            ON P.COMPLAINT_ID = H.COMPLAINT_ID
        WHERE TRUNC(H.CREATED_DATE) = TRUNC(SYSDATE)
        --    AND TRUNC(H.CREATED_DATE) < TRUNC(SYSDATE) + 1
        ORDER BY H.CREATED_DATE DESC NULLS LAST,
                 H.COMPLAINT_ID DESC
        FETCH FIRST 8 ROWS ONLY
    )
    LOOP
        L_FOUND := TRUE;

        ADD_HTML(
            '<tr>' ||

            '<td><b>' ||
            E(C.COMPLAINT_NO) ||
            '</b></td>' ||

            '<td>' ||
            E(NVL(C.MACHINE_NAME, 'N/A')) ||
            '</td>' ||

            '<td><div class="eh-part-name">' ||
            E(SUBSTR(C.FAULT_DESCRIPTION, 1, 65)) ||
            '</div></td>' ||

            '<td>' ||
            STATUS_BADGE(C.STATUS_CODE) ||
            '</td>' ||

            '<td>' ||
            N(C.TOTAL_ITEMS) ||
            '</td>' ||

            '<td><span class="eh-part-qty">' ||
            N(C.TOTAL_QTY) ||
            '</span></td>' ||

            '<td><span class="eh-part-total">' ||
            MONEY(C.TOTAL_PRICE) ||
            '</span></td>' ||

            '</tr>'
        );
    END LOOP;

    IF NOT L_FOUND THEN
        ADD_HTML(
            '<tr><td colspan="7">No complaints found today.</td></tr>'
        );
    END IF;
END;

ADD_HTML('</tbody></table></div></div>');


    ------------------------------------------------------------------
    -- 9. COMPLAINT WISE INDIVIDUAL CHANGE PART DETAILS
    ------------------------------------------------------------------

ADD_HTML(
    '<div class="eh-section-title">Change Parts Details</div>' ||
    '<div class="eh-panel">' ||
    '<h3><span>◇</span> Individual Spare Parts Used</h3>' ||
    '<div class="eh-table-wrap"><table class="eh-table">' ||
    '<thead><tr>' ||
    '<th>Complaint No</th>' ||
    '<th>Part Item ID</th>' ||
    '<th>Part Name</th>' ||
    '<th>Quantity</th>' ||
    '<th>Unit Price</th>' ||
    '<th>Total Price</th>' ||
    '<th>REMARKS</th>' ||
    '</tr></thead><tbody>'
);

DECLARE
    L_FOUND BOOLEAN := FALSE;
BEGIN
    FOR P IN (
        SELECT
            H.COMPLAINT_NO,
            CP.COMPLAINT_ID,
            CP.CHANGE_PART_ITEM_ID,
            CP.CHANGE_PARTS_NAME,
            CP.CHANGE_PARTS_PRICE,
            CP.CHANGE_PARTS_QTY,
            CP.REMARKS
        FROM MS_CHANGE_PART CP
        LEFT JOIN MS_COMPLAINT_H H  ON H.COMPLAINT_ID = CP.COMPLAINT_ID
        WHERE TRUNC(H.CREATED_DATE) = TRUNC(SYSDATE)
        ORDER BY CP.COMPLAINT_ID DESC, CP.ID DESC
        FETCH FIRST 30 ROWS ONLY
    )
    LOOP
        L_FOUND := TRUE;

        ADD_HTML(
            '<tr>' ||

            '<td><b>' ||
            E(NVL(P.COMPLAINT_NO, TO_CHAR(P.COMPLAINT_ID))) ||
            '</b></td>' ||

            '<td>' ||
            N(P.CHANGE_PART_ITEM_ID) ||
            '</td>' ||

            '<td><div class="eh-part-name">' ||
            E(NVL(P.CHANGE_PARTS_NAME,
                'Item ID: ' || TO_CHAR(P.CHANGE_PART_ITEM_ID))) ||
            '</div></td>' ||

            '<td><span class="eh-part-qty">' ||
            N(P.CHANGE_PARTS_QTY) ||
            '</span></td>' ||

            '<td>' ||
            MONEY(P.CHANGE_PARTS_PRICE) ||
            '</td>' ||

            '<td><span class="eh-part-total">' ||
            MONEY(
                NVL(P.CHANGE_PARTS_PRICE, 0) *
                NVL(P.CHANGE_PARTS_QTY, 0)
            ) ||
            '</span></td>' ||

            '<td>' ||
            E(P.REMARKS) ||
            '</td>' ||

            '</tr>'
        );
    END LOOP;

    IF NOT L_FOUND THEN
        ADD_HTML(
            '<tr><td colspan="7">' ||
            'No change parts records found.' ||
            '</td></tr>'
        );
    END IF;
END;

ADD_HTML('</tbody></table></div></div>');

    ------------------------------------------------------------------
    -- 11. MACHINE SELECTION
    ------------------------------------------------------------------

    IF P_HALL_ID IS NOT NULL THEN

        ADD_HTML('<div class="eh-section-title">Hall Machines</div>');
        ADD_HTML('<div class="eh-hall-grid">');

        DECLARE
            L_FOUND BOOLEAN := FALSE;
        BEGIN
            FOR M IN (
                SELECT MACHINE_ID,MACHINE_CODE,MACHINE_NAME,
                       MODEL_NO,SERIAL_NO
                  FROM EM_MACHINES
                 WHERE HALL_ID = P_HALL_ID
                   AND ACTIVE_YN = 'Y'
                 ORDER BY MACHINE_NAME
            )
            LOOP
                DECLARE
                    L_URL VARCHAR2(4000);
                BEGIN
                    L_FOUND := TRUE;

                    L_URL := APEX_PAGE.GET_URL(
                        P_PAGE => 3,
                        P_ITEMS => 'P3_DEPARTMENT_ID,P3_MACHINE_ID',
                        P_VALUES => TO_CHAR(P_HALL_ID) || ',' ||
                                    TO_CHAR(M.MACHINE_ID)
                    );

                    ADD_HTML(
                      '<a class="eh-card machine" href="' ||
                      APEX_ESCAPE.HTML_ATTRIBUTE(L_URL) || '">' ||
                      '<div class="eh-card-icon">⚙</div>' ||
                      '<div class="eh-card-title">' ||
                      E(M.MACHINE_NAME) || '</div>' ||
                      '<div class="eh-card-meta">Code: ' ||
                      E(M.MACHINE_CODE) || '</div>' ||
                      '<div class="eh-card-meta">Model: ' ||
                      E(M.MODEL_NO) || '</div>' ||
                      '<span class="eh-card-count">SELECT MACHINE</span>' ||
                      '<span class="eh-card-arrow">→</span>' ||
                      '</a>'
                    );
                END;
            END LOOP;

            IF NOT L_FOUND THEN
                ADD_HTML('<div class="eh-empty">No machines found in this hall.</div>');
            END IF;
        END;

        ADD_HTML('</div>');
    END IF;

    ------------------------------------------------------------------
    -- 12. MACHINE FAULT SELECTION
    ------------------------------------------------------------------

    IF P_HALL_ID IS NOT NULL AND P_MACHINE_ID IS NOT NULL THEN

        ADD_HTML('<div class="eh-section-title">Machine Faults</div>');
        ADD_HTML('<div class="eh-hall-grid">');

        DECLARE
            L_FOUND BOOLEAN := FALSE;
        BEGIN
            FOR F IN (
                SELECT MACHINE_FAULT_ID,FAULT_CODE,FAULT_NAME,
                       SEVERITY,FAULT_DESCRIPTION
                  FROM EM_MACHINE_FAULTS
                 WHERE MACHINE_ID = P_MACHINE_ID
                   AND ACTIVE_YN = 'Y'
                 ORDER BY FAULT_NAME
            )
            LOOP
                DECLARE
                    L_URL VARCHAR2(4000);
                BEGIN
                    L_FOUND := TRUE;

                    L_URL := APEX_PAGE.GET_URL(
                        P_PAGE => 3,
                        P_ITEMS =>
                            'P3_DEPARTMENT_ID,P3_MACHINE_ID,P3_MACHINE_FAULT_ID',
                        P_VALUES =>
                            TO_CHAR(P_HALL_ID) || ',' ||
                            TO_CHAR(P_MACHINE_ID) || ',' ||
                            TO_CHAR(F.MACHINE_FAULT_ID)
                    );

                    ADD_HTML(
                      '<a class="eh-card fault" href="' ||
                      APEX_ESCAPE.HTML_ATTRIBUTE(L_URL) || '">' ||
                      '<div class="eh-card-icon">⚠</div>' ||
                      '<div class="eh-card-title">' ||
                      E(F.FAULT_NAME) || '</div>' ||
                      '<div class="eh-card-meta">Fault Code: ' ||
                      E(F.FAULT_CODE) || '</div>' ||
                      '<div class="eh-card-meta">Severity: ' ||
                      E(F.SEVERITY) || '</div>' ||
                      '<span class="eh-card-count">ISSUE COMPLAINT</span>' ||
                      '<span class="eh-card-arrow">→</span>' ||
                      '</a>'
                    );
                END;
            END LOOP;

            IF NOT L_FOUND THEN
                ADD_HTML('<div class="eh-empty">No active faults found.</div>');
            END IF;
        END;

        ADD_HTML('</div>');
    END IF;

    ------------------------------------------------------------------
    -- 13. FOOTER
    ------------------------------------------------------------------

    ADD_HTML(
      '<div class="eh-footer">' ||
      '<span>● System Online | Oracle APEX</span>' ||
      '<span>Master Textile Limited | MMS Engineering</span>' ||
      '</div></div>'
    );

    RETURN L_HTML;

END GET_DASHBOARD_HTML;

