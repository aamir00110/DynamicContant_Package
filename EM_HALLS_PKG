/*Using this package for dashboad for Complete application*/

create or replace PACKAGE EM_HALLS_PKG AS

    FUNCTION GET_DASHBOARD_HTML (
        P_HALL_ID           IN NUMBER DEFAULT NULL,
        P_MACHINE_ID        IN NUMBER DEFAULT NULL,
        P_MACHINE_FAULT_ID  IN NUMBER DEFAULT NULL
    ) RETURN CLOB;

END EM_HALLS_PKG;
/
create or replace PACKAGE BODY EM_HALLS_PKG AS

FUNCTION GET_DASHBOARD_HTML (
    P_HALL_ID           IN NUMBER DEFAULT NULL,
    P_MACHINE_ID        IN NUMBER DEFAULT NULL,
    P_MACHINE_FAULT_ID  IN NUMBER DEFAULT NULL
) RETURN CLOB
IS
    L_HTML              CLOB;
    L_TOTAL             NUMBER := 0;
    L_RESOLVED          NUMBER := 0;
    L_PENDING           NUMBER := 0;
    L_CANCELLED           NUMBER := 0;
    L_PM_DUE            NUMBER := 0;
    L_RUNNING           NUMBER := 0;
    L_DOWN               NUMBER := 0;
    L_MAINTENANCE       NUMBER := 0;
    L_TOTAL_MACHINES    NUMBER := 0;

    PROCEDURE ADD_HTML(P_TEXT IN VARCHAR2) IS
    BEGIN
        L_HTML := L_HTML || P_TEXT;
    END;

    FUNCTION E(P_VALUE IN VARCHAR2) RETURN VARCHAR2 IS
    BEGIN
        RETURN APEX_ESCAPE.HTML(P_VALUE);
    END;

    FUNCTION N(P_VALUE IN NUMBER) RETURN VARCHAR2 IS
    BEGIN
        RETURN TO_CHAR(NVL(P_VALUE,0),'FM999G999G999G990');
    END;

    FUNCTION ICON(P_TYPE IN VARCHAR2) RETURN VARCHAR2 IS
        L_PATH VARCHAR2(2000);
    BEGIN
        L_PATH := CASE P_TYPE
            WHEN 'COMPLAINT' THEN
                '<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>'
            WHEN 'CHECK' THEN
                '<path d="m5 12 4 4L19 6"/>'
            WHEN 'CLOCK' THEN
                '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>'
            WHEN 'CALENDAR' THEN
                '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>'
            WHEN 'MACHINE' THEN
                '<circle cx="12" cy="12" r="3"/><path d="M12 2v3m0 14v3M2 12h3m14 0h3"/>'
            WHEN 'HALL' THEN
                '<path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/>'
            WHEN 'CANCEL' THEN
                '<circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/>'
            WHEN 'PM' THEN
                '<path d="M12 8v4l3 2"/><circle cx="12" cy="12" r="10"/>'
            WHEN 'PART' THEN
                '<path d="m12 2 9 5-9 5-9-5 9-5z"/><path d="m3 12 9 5 9-5M3 17l9 5 9-5"/>'
            ELSE
                '<path d="M12 3v18M3 12h18"/>'
        END;

        RETURN
            '<span class="eh-dash-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' ||
            L_PATH || '</svg></span>';
    END;

    FUNCTION STATUS_BADGE(P_STATUS IN VARCHAR2) RETURN VARCHAR2 IS
        L_CLASS VARCHAR2(30);
    BEGIN
        L_CLASS := CASE UPPER(NVL(P_STATUS,'UNKNOWN'))
            WHEN 'CLOSED'       THEN 'green'
            WHEN 'RESOLVED'     THEN 'green'
            WHEN 'COMPLETED'    THEN 'green'
            WHEN 'ACKNOWLEDGED' THEN 'blue'
            WHEN 'IN PROGRESS'  THEN 'blue'
            WHEN 'IN_PROGRESS'  THEN 'blue'
            WHEN 'STARTED'      THEN 'blue'
            WHEN 'PENDING'      THEN 'orange'
            WHEN 'OPEN'         THEN 'orange'
            WHEN 'CANCELLED'    THEN 'gray'
            ELSE 'purple'
        END;

        RETURN '<span class="eh-status ' || L_CLASS || '">' ||
               E(P_STATUS) || '</span>';
    END;

    ------------------------------------------------------------------
    -- KPI CARD (P_PAGE given => whole card becomes a clickable link)
    ------------------------------------------------------------------
    FUNCTION KPI(
        P_LABEL IN VARCHAR2,
        P_VALUE IN NUMBER,
        P_ICON  IN VARCHAR2,
        P_CLASS IN VARCHAR2,
        P_NOTE  IN VARCHAR2,
        P_PAGE  IN NUMBER DEFAULT NULL
    ) RETURN VARCHAR2 IS
        L_CARD VARCHAR2(4000);
        L_URL  VARCHAR2(4000);
    BEGIN
        L_CARD :=
            '<div class="eh-kpi ' || P_CLASS ||
            CASE WHEN P_PAGE IS NOT NULL THEN ' clickable' END || '">' ||
                '<div class="eh-kpi-top">' ||
                    ICON(P_ICON) ||
                    '<span class="eh-kpi-note">' || E(P_NOTE) || '</span>' ||
                '</div>' ||
                '<div class="eh-kpi-value">' || N(P_VALUE) || '</div>' ||
                '<div class="eh-kpi-label">' || E(P_LABEL) || '</div>' ||
            '</div>';

        IF P_PAGE IS NULL THEN
            RETURN L_CARD;
        END IF;

        L_URL := APEX_PAGE.GET_URL(P_PAGE => P_PAGE);

        RETURN
            '<a class="eh-kpi-link" href="' ||
            APEX_ESCAPE.HTML_ATTRIBUTE(L_URL) ||
            '" title="Open ' || E(P_LABEL) || '">' ||
            L_CARD ||
            '</a>';
    END;

    FUNCTION MONEY(P_VALUE IN NUMBER) RETURN VARCHAR2 IS
    BEGIN
        RETURN TO_CHAR(
            NVL(P_VALUE,0),
            'FM999G999G999G990D00'
        );
    END;

BEGIN

    L_HTML := EMPTY_CLOB();

    ------------------------------------------------------------------
    -- 1. COMPLAINT KPI
    ------------------------------------------------------------------

    SELECT COUNT(*),
           NVL(SUM(
               CASE
                   WHEN UPPER(STATUS_CODE) IN ('RESOLVED','CLOSED')
                   THEN 1 ELSE 0
               END
           ),0),
           NVL(SUM(
               CASE
                   WHEN STATUS_CODE = 'CANCELLED'
                   THEN 1 ELSE 0
               END
           ),0),
             NVL(SUM(
               CASE
                   WHEN STATUS_CODE = 'Submitted'
                   THEN 1 ELSE 0
               END
           ),0)
      INTO L_TOTAL,L_RESOLVED,L_CANCELLED,L_PENDING
      FROM MS_COMPLAINT_H;

    ------------------------------------------------------------------
    -- 2. PM DUE
    ------------------------------------------------------------------

    SELECT COUNT(*)
      INTO L_PM_DUE
      FROM MS_PM_SCHEDULE
     WHERE DUE_DATE >= TRUNC(SYSDATE)
       AND DUE_DATE < TRUNC(SYSDATE)+8
       AND UPPER(NVL(STATUS_CODE,'PENDING'))
           NOT IN ('COMPLETED','CLOSED','CANCELLED');

    ------------------------------------------------------------------
    -- 3. MACHINE STATUS
    ------------------------------------------------------------------

---------------------------------------------------------------------
    SELECT COUNT(*)
      INTO L_TOTAL_MACHINES
      FROM EM_MACHINES
     WHERE ACTIVE_YN = 'Y';

   SELECT COUNT(DISTINCT M.MACHINE_ID)
      INTO L_DOWN
      FROM EM_MACHINES M
      JOIN MS_COMPLAINT_H C
        ON C.MACHINE_ID = M.MACHINE_ID
     WHERE M.ACTIVE_YN = 'Y'
       AND C.MACHINE_STOPPED = 'Y'
       AND C.STATUS_CODE ='Submitted';

    SELECT COUNT(DISTINCT M.MACHINE_ID)
      INTO L_MAINTENANCE
      FROM EM_MACHINES M
      JOIN MS_COMPLAINT_H C
        ON C.MACHINE_ID = M.MACHINE_ID
     WHERE M.ACTIVE_YN = 'Y'
       AND C.STATUS_CODE IN ('ACKNOWLEDGED','IN PROGRESS')
       AND TRUNC(C.CREATED_DATE)=TRUNC(SYSDATE);
    --    AND NOT EXISTS (
    --        SELECT 1
    --          FROM MS_COMPLAINT_H C2
    --         WHERE C2.MACHINE_ID = M.MACHINE_ID
    --           AND C2.MACHINE_STOPPED = 'Y'
    --           AND C.STATUS_CODE IN ('ACKNOWLEDGED','CLOSED','CANCELLED');
    --    );

    L_RUNNING := GREATEST(L_TOTAL_MACHINES-L_DOWN-L_MAINTENANCE,0 );
    ------------------------------------------------------------------
