 PROCEDURE UPDATE_COMPLAINT_RR 
    (
        P_COMPLAINT_NO          IN MS_COMPLAINT_H.COMPLAINT_NO%TYPE,
        P_REASON                IN MS_COMPLAINT_H.REASON%TYPE,
        P_REMARKS               IN MS_COMPLAINT_H.REMARKS%TYPE,
